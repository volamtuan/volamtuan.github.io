        <textarea id="manualText" class="form-control form-control-sm" rows="5" placeholder="✍️ Nhập thủ công list user|pass (mỗi ô 1 dòng)"></textarea>
        <button class="btn btn-sm btn-secondary mt-1" onclick="processManual()">Xử lý ngay</button>
    </div>

    <div class="progress">
        <div id="progressBar" class="progress-bar bg-success" role="progressbar" style="width: 0%"></div>
    </div>

    <div id="deepExtractArea">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <strong><i class="fas fa-database"></i> Dữ liệu Full Info từ DB (Uid|Pass|Cookie|Mail...)</strong>
            <div>
                <button class="btn btn-xs btn-warning copy-btn-sm" onclick="copyDeepData()">Copy All</button>
                <button class="btn btn-xs btn-light copy-btn-sm" onclick="clearDeepData()">Xóa</button>
            </div>
        </div>
        <textarea id="deepExtractText" readonly></textarea>
    </div>
</div>

<div class="main-content">
    
    <div class="left-panel">
        <div class="p-2 border-bottom bg-light d-flex">
            <input type="text" id="searchDomain" class="form-control form-control-sm" placeholder="🔍 Lọc domain..." onkeyup="filterDomains()">
        </div>
        <div class="domain-list-wrapper" id="domainList">
            <div class="text-center text-muted mt-5 small">Chưa có dữ liệu</div>
        </div>
        <div class="p-2 border-top bg-light text-right small">
            <span id="totalDomains">0</span> domains / <span id="totalAccounts">0</span> accs
        </div>
    </div>

    <div class="right-panel">
        <div class="p-2 border-bottom bg-light d-flex justify-content-between align-items-center">
            <strong id="selectedDomainName" class="text-primary">---</strong>
            <button id="copyCurrentBtn" class="btn btn-sm btn-outline-primary" disabled onclick="copyCurrentDomain()">Copy List Này</button>
        </div>
        <div class="account-list-wrapper" id="accountList">
            <div class="text-center text-muted mt-5 small">Chọn domain bên trái để xem</div>
        </div>
    </div>

</div>

<script>
// ==========================================
// 1. CONFIG & STATE
// ==========================================
let SQL = null;
const domainMap = new Map(); // Map<domain, Set<"user|pass">> -> Dùng Set để tự loại trùng
let deepDataBuffer = [];     // Lưu trữ mảng các dòng full info
let isProcessing = false;

// UI Refs
const els = {
    status: document.getElementById('statusText'),
    progress: document.getElementById('progressBar'),
    domainList: document.getElementById('domainList'),
    accList: document.getElementById('accountList'),
    selDomName: document.getElementById('selectedDomainName'),
    copyBtn: document.getElementById('copyCurrentBtn'),
    deepArea: document.getElementById('deepExtractArea'),
    deepText: document.getElementById('deepExtractText'),
    totalDom: document.getElementById('totalDomains'),
    totalAcc: document.getElementById('totalAccounts')
};

// ==========================================
// 2. INITIALIZATION
// ==========================================
(async function init() {
    try {
        SQL = await initSqlJs({ locateFile: f => `https://cdnjs.cloudflare.com/ajax/libs/sql.js/1.6.2/${f}` });
        els.status.innerHTML = '<span class="text-success"><i class="fas fa-check-circle"></i> Hệ thống đã sẵn sàng</span>';
    } catch (e) {
        els.status.innerHTML = '<span class="text-danger">Lỗi tải thư viện SQL.js! Vui lòng kiểm tra mạng.</span>';
    }
})();

// ==========================================
// 3. CORE PROCESSING LOGIC
// ==========================================

// Hàm thêm tài khoản vào bộ nhớ (Dùng Set để siêu tốc độ và tự loại trùng)
function addAccount(user, pass, domain) {
    if (!user || !pass || !domain) return;
    if (domain.length < 3 || !domain.includes('.')) return;

    if (!domainMap.has(domain)) {
        domainMap.set(domain, new Set());
    }
    domainMap.get(domain).add(`${user}|${pass}`);
}

// Hàm Parser Text (Tối ưu hóa không dùng Regex phức tạp cho từng dòng)
function parseTextChunk(text) {
    const lines = text.split(/\r?\n/);
    const len = lines.length;
    
    for (let i = 0; i < len; i++) {
        let line = lines[i].trim();
        if (!line) continue;

        // 1. Fast Check: user|pass or user:pass
        let sep = line.indexOf('|');
        if (sep === -1) sep = line.indexOf(':');

        if (sep > 0 && sep < line.length - 1) {
            // Kiểm tra sơ bộ xem có phải email không
            if (line.indexOf('@') > -1 && line.indexOf('@') < sep) {
                const user = line.substring(0, sep).trim();
                const pass = line.substring(sep + 1).trim();
                const atIdx = user.lastIndexOf('@');
                if (atIdx !== -1) {
                    const domain = user.substring(atIdx + 1).toLowerCase();
                    addAccount(user, pass, domain);
                    continue; // Done row
                }
            }
        }

        // 2. Block Check (URL/User/Pass) - Chỉ chạy khi dòng bắt đầu bằng URL
        if (line.toLowerCase().startsWith('url:') && i + 2 < len) {
            try {
                // Lấy URL
                let uStr = line.substring(4).trim();
                if (!uStr.startsWith('http')) uStr = 'http://' + uStr;
                const domain = new URL(uStr).hostname.toLowerCase().replace('www.', '');

                // Quét 5 dòng tiếp theo tìm User/Pass
                let user, pass;
                for (let j = 1; j <= 5; j++) {
                    if (i + j >= len) break;
                    const next = lines[i+j];
                    if (!user && (next.match(/^use?r(?:name)?[:|]/i) || next.match(/^mail[:|]/i) || next.match(/^login[:|]/i))) {
                        user = next.split(/[:|]/).slice(1).join(':').trim();
                    }
                    if (!pass && (next.match(/^pass(?:word)?[:|]/i) || next.match(/^pwd[:|]/i))) {
                        pass = next.split(/[:|]/).slice(1).join(':').trim();
                    }
                }
                if (domain && user && pass) {
                    addAccount(user, pass, domain);
                    i += 2; // Skip lines
                }
            } catch (e) {}
        }
    }
}

// Handler SQLite (Dual Mode: Extract & Scan)
function processSQLiteDB(uint8Array, fileName) {
    if (!SQL) return;
    let db = null;
    try {
        db = new SQL.Database(uint8Array);
        
        // MODE 1: DEEP EXTRACT (Lấy Full Data)
        try {
            // Query ưu tiên các cột quan trọng
            const stmt = db.prepare("SELECT * FROM accounts LIMIT 1"); // Check columns first
            const cols = stmt.getColumnNames();
            stmt.free();

            // Xây dựng câu query động dựa trên cột có sẵn
            const targetCols = ["uid", "id", "user", "username", "email", "pass", "password", "cookie", "cookies", "fa2", "2fa", "token"];
            const availableCols = cols.filter(c => targetCols.includes(c.toLowerCase()));
            
            if (availableCols.length > 2) {
                const res = db.exec(`SELECT ${availableCols.join(',')} FROM accounts`);
                if (res.length) {
                    const rows = res[0].values;
                    const header = `[FILE: ${fileName}] Columns: ${availableCols.join('|')}`;
                    const content = rows.map(r => r.join('|')).join('\n');
                    
                    // Add to Deep Buffer
                    deepDataBuffer.push(header);
                    deepDataBuffer.push(content);
                    deepDataBuffer.push("-".repeat(20));

                    // Add to Parser (để lọc user|pass vào list domain)
                    parseTextChunk(content);
                }
            }
        } catch (e) { /* Table accounts not found */ }

        // MODE 2: GENERIC SCAN (Quét mọi bảng)
        const tables = db.exec("SELECT name FROM sqlite_master WHERE type='table'")[0]?.values.flat() || [];
        for (const tbl of tables) {
            try {
                // Check 1 dòng để xem cột
                const check = db.exec(`SELECT * FROM "${tbl}" LIMIT 1`);
                if (!check.length) continue;
                
                const cols = check[0].columns.map(c => c.toLowerCase());
                const uIdx = cols.findIndex(c => c.includes('user') || c.includes('mail') || c.includes('login') || c.includes('uid'));
                const pIdx = cols.findIndex(c => c.includes('pass') || c.includes('pwd'));
                
                if (uIdx > -1 && pIdx > -1) {
                    // Lấy dữ liệu (Limit để tránh treo nếu bảng quá lớn)
                    const data = db.exec(`SELECT * FROM "${tbl}" LIMIT 50000`);
                    let tempTxt = "";
                    data[0].values.forEach(row => {
                        const u = row[uIdx];
                        const p = row[pIdx];
                        if (u && p) tempTxt += `${u}|${p}\n`;
                    });
                    parseTextChunk(tempTxt);
                }
            } catch (err) {}
        }

    } catch (e) { console.error(e); } 
    finally { if (db) db.close(); }
}

// ==========================================
// 4. FILE SYSTEM HANDLERS
// ==========================================

async function handleFile(file) {
    const ext = file.name.split('.').pop().toLowerCase();
    
    if (ext === 'txt' || ext === 'log') {
        const text = await file.text();
        parseTextChunk(text);
    } 
    else if (ext === 'db' || ext === 'sqlite') {
        const buf = await file.arrayBuffer();
        processSQLiteDB(new Uint8Array(buf), file.name);
    } 
    else if (ext === 'zip') {
        try {
            const zip = await JSZip.loadAsync(file);
            // Lọc file để xử lý
            const filesInside = Object.values(zip.files).filter(e => !e.dir);
            for (const entry of filesInside) {
                const subExt = entry.name.split('.').pop().toLowerCase();
                if (['txt', 'log'].includes(subExt)) {
                    const t = await entry.async('string');
                    parseTextChunk(t);
                } else if (['db', 'sqlite'].includes(subExt)) {
                    const b = await entry.async('uint8array');
                    processSQLiteDB(b, file.name + "/" + entry.name);
                }
            }
        } catch (e) { console.error("Zip Error", e); }
    }
}

// MAIN PROCESSOR (With Chunking to prevent freeze)
async function startProcessing(fileList) {
    if (isProcessing) return;
    isProcessing = true;
    
    els.progress.style.width = '0%';
    els.status.innerText = `Đang xử lý ${fileList.length} file...`;
    
    // Chunking: Process 10 files then wait 0ms to let UI update
    const chunkSize = 5; 
    let processed = 0;

    for (let i = 0; i < fileList.length; i += chunkSize) {
        const chunk = Array.from(fileList).slice(i, i + chunkSize);
        await Promise.all(chunk.map(f => handleFile(f)));
        
        processed += chunk.length;
        const pct = Math.min(100, Math.round((processed / fileList.length) * 100));
        els.progress.style.width = pct + '%';
        els.status.innerText = `Đã xử lý ${processed}/${fileList.length}`;
        
        // Update UI (Deep Extract) real-time if needed
        if (deepDataBuffer.length > 0) {
            els.deepArea.style.display = 'block';
            els.deepText.value = deepDataBuffer.join('\n'); // Show preview
        }
        
        // Yield to main thread
        await new Promise(r => setTimeout(r, 0));
    }

    renderDomainList();
    els.status.innerHTML = `<span class="text-success font-weight-bold">Hoàn tất!</span>`;
    isProcessing = false;
}

// ==========================================
// 5. RENDERING & UI LOGIC
// ==========================================

function renderDomainList() {
    els.domainList.innerHTML = "";
    const sorted = [...domainMap.entries()].sort((a, b) => b[1].size - a[1].size);
    
    let totalDoms = 0;
    let totalAccs = 0;

    // Sử dụng DocumentFragment để render cực nhanh
    const frag = document.createDocumentFragment();
    
    sorted.forEach(([domain, set]) => {
        const count = set.size;
        totalDoms++;
        totalAccs += count;

        const div = document.createElement('div');
        div.className = 'domain-row';
        div.innerHTML = `<span>${domain}</span> <span class="badge-count">${count}</span>`;
        div.onclick = () => selectDomain(div, domain);
        frag.appendChild(div);
    });

    els.domainList.appendChild(frag);
    els.totalDom.innerText = totalDoms;
    els.totalAcc.innerText = totalAccs;
}

function selectDomain(el, domain) {
    // Highlight UI
    document.querySelectorAll('.domain-row').forEach(e => e.classList.remove('active'));
    el.classList.add('active');
    
    // Render Accounts
    els.selDomName.innerText = domain;
    els.copyBtn.disabled = false;
    els.accList.innerHTML = "";
    
    const set = domainMap.get(domain);
    const frag = document.createDocumentFragment();
    
    // Limit view to 1000 to prevent lag, but copy will copy all
    let i = 0;
    for (const item of set) {
        if (i++ > 500) {
            const more = document.createElement('div');
            more.className = 'text-center p-2 text-muted font-italic';
            more.innerText = `...và ${set.size - 500} tài khoản khác...`;
            frag.appendChild(more);
            break;
        }
        
        const row = document.createElement('div');
        row.className = 'acc-row';
        row.innerHTML = `
            <span class="acc-data">${item}</span>
            <button class="btn btn-light btn-sm py-0 border" onclick="copyText('${item}')"><i class="fas fa-copy"></i></button>
        `;
        frag.appendChild(row);
    }
    
    els.accList.appendChild(frag);
}

function filterDomains() {
    const term = document.getElementById('searchDomain').value.toLowerCase();
    const rows = document.querySelectorAll('.domain-row');
    rows.forEach(row => {
        const txt = row.firstChild.textContent;
        row.style.display = txt.includes(term) ? 'flex' : 'none';
    });
}

// ==========================================
// 6. ACTIONS (COPY, EXPORT, MANUAL)
// ==========================================

function copyText(txt) {
    navigator.clipboard.writeText(txt);
}

function copyCurrentDomain() {
    const dom = els.selDomName.innerText;
    const set = domainMap.get(dom);
    if(set) {
        navigator.clipboard.writeText(Array.from(set).join('\n'));
        alert(`Đã copy ${set.size} tài khoản!`);
    }
}

function copyDeepData() {
    els.deepText.select();
    document.execCommand('copy');
    alert("Copied SQL Data!");
}

function clearDeepData() {
    deepDataBuffer = [];
    els.deepText.value = "";
    els.deepArea.style.display = 'none';
}

function toggleManualInput() {
    const area = document.getElementById('manualInputArea');
    area.style.display = area.style.display === 'none' ? 'block' : 'none';
}

function processManual() {
    const txt = document.getElementById('manualText').value;
    if(txt) {
        parseTextChunk(txt);
        renderDomainList();
        document.getElementById('manualText').value = "";
        toggleManualInput();
    }
}

function exportAll() {
    if(domainMap.size === 0) return alert("Chưa có dữ liệu!");
    let content = "";
    for (const [dom, set] of domainMap) {
        content += Array.from(set).join('\n') + "\n";
    }
    const blob = new Blob([content], {type: "text/plain;charset=utf-8"});
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `All_Accounts_${Date.now()}.txt`;
    a.click();
}

// Event Listeners
document.getElementById('fileInput').addEventListener('change', function() { startProcessing(this.files); });
document.getElementById('folderInput').addEventListener('change', function() { startProcessing(this.files); });

</script>
